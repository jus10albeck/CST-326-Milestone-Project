@model EquipmentInventoryApp.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="visually-hidden">Admin Dashboard</h1>

@* Summary cards. Each count is queried fresh on every page load (FR-39),
   and selecting one opens the matching list (FR-40). *@
<div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3 g-lg-4 mb-5">

    <div class="col">
        <div class="stat-card">
            <div class="stat-number">@Model.TotalEquipmentCount</div>
            <div class="stat-label">Total Equipment</div>
            <a asp-controller="Equipment"
               asp-action="Index"
               class="stat-link">View List &gt;</a>
        </div>
    </div>

    <div class="col">
        <div class="stat-card">
            <div class="stat-number">@Model.CheckedOutCount</div>
            <div class="stat-label">Checked Out</div>
            <a asp-controller="Equipment"
               asp-action="Index"
               asp-route-status="Checked Out"
               class="stat-link">View List &gt;</a>
        </div>
    </div>

    <div class="col">
        <div class="stat-card">
            <div class="stat-number">@Model.OverdueCount</div>
            <div class="stat-label">Overdue</div>
            <a asp-controller="Admin"
               asp-action="Overdue"
               class="stat-link">View List &gt;</a>
        </div>
    </div>

    <div class="col">
        <div class="stat-card">
            <div class="stat-number">@Model.UnderRepairCount</div>
            <div class="stat-label">Under Repair</div>
            <a asp-controller="Equipment"
               asp-action="Index"
               asp-route-status="Under Repair"
               class="stat-link">View List &gt;</a>
        </div>
    </div>

    <div class="col">
        <div class="stat-card">
            <div class="stat-number">@Model.LostCount</div>
            <div class="stat-label">Lost</div>
            <a asp-controller="Equipment"
               asp-action="Index"
               asp-route-status="Lost"
               class="stat-link">View List &gt;</a>
        </div>
    </div>

    @* Requests waiting for approval; opens the Reservations page *@
    <div class="col">
        <div class="stat-card">
            <div class="stat-number">@Model.PendingReservationCount</div>
            <div class="stat-label">Pending Reservations</div>
            <a asp-controller="Reservations"
               asp-action="Index"
               class="stat-link">View List &gt;</a>
        </div>
    </div>
</div>

@* The most overdue items; the full list is on the Overdue List page *@
<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
    <h2 id="overdue-equipment" class="h5 fw-bold mb-0">Overdue Equipment</h2>

    @if (Model.OverdueCount > Model.OverdueItems.Count)
    {
        <a asp-controller="Admin" asp-action="Overdue" class="small">
            View all @Model.OverdueCount overdue items &gt;
        </a>
    }
</div>

<div class="table-responsive">
    <table class="table app-table mb-0">
        <thead>
            <tr>
                <th scope="col">Item</th>
                <th scope="col">Employee</th>
                <th scope="col">Due Date</th>
                <th scope="col">Days Overdue</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.OverdueItems.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-3">
                        No equipment is overdue.
                    </td>
                </tr>
            }

            @foreach (var item in Model.OverdueItems)
            {
                <tr>
                    <td>
                        <a asp-controller="Equipment"
                           asp-action="Details"
                           asp-route-id="@item.EquipmentId">@item.ItemName</a>
                    </td>
                    <td>@item.EmployeeName</td>
                    <td>@item.DueDate.ToString("MM/dd/yyyy")</td>
                    <td>@item.DaysOverdue</td>
                </tr>
            }
        </tbody>
    </table>
</div>
