@model EquipmentInventoryApp.Models.Equipment

@{
    ViewData["Title"] = Model.Name;

    // Shows the item's photo, or the placeholder image when it has none (FR-15, FR-19)
    var hasPhoto = !string.IsNullOrWhiteSpace(Model.PhotoPath);
    var photoSource = hasPhoto
        ? Model.PhotoPath
        : Url.Content("~/images/equipment-placeholder.jpg");
    var photoAlt = hasPhoto
        ? $"Photo of {Model.Name}"
        : "No photo available";

    // Set by the controller for employees only
    var checkout = ViewBag.CheckoutAvailability as EquipmentInventoryApp.Services.CheckoutAvailability;

    // Reserved is shown while an Approved reservation covers today (FR-28)
    var displayStatus = ViewBag.DisplayStatus as string ?? Model.Status;
    var reservedForMe = ViewBag.ReservedForCurrentUser as bool? == true;

    // Administrators only
    var isAdmin = User.IsInRole("Administrator");
    var activeCheckout = ViewBag.ActiveCheckout as EquipmentInventoryApp.Models.Checkout;
    var isRetired = Model.Status == "Retired";

    // What was typed before an error, so it can be shown again
    var statusDraft = TempData["StatusDraft"] as string;
    var repairNoteDraft = TempData["RepairNoteDraft"] as string;
    var selectedStatus = statusDraft ?? Model.Status;
    var repairNoteValue = repairNoteDraft ?? Model.RepairNote;

    // Item History, newest first (administrators only)
    var checkoutHistory = ViewBag.CheckoutHistory
        as EquipmentInventoryApp.ViewModels.PagedResult<EquipmentInventoryApp.Services.CheckoutHistoryRow>;
    var changeHistory = ViewBag.ChangeHistory
        as EquipmentInventoryApp.ViewModels.PagedResult<EquipmentInventoryApp.Services.ItemHistoryRow>;

    // Request Reservation (employees only). The dates come back after an error.
    var upcomingReservations = ViewBag.UpcomingReservations
        as List<EquipmentInventoryApp.Services.ReservedDateRange>
        ?? new List<EquipmentInventoryApp.Services.ReservedDateRange>();
    // TempData gives back date text as a DateTime, so both forms are handled
    string? DateDraft(object? value) => value switch
    {
        DateTime date => date.ToString("yyyy-MM-dd"),
        string text when !string.IsNullOrWhiteSpace(text) => text,
        _ => null
    };
    var reservationStartDraft = DateDraft(TempData["ReservationStartDraft"]);
    var reservationEndDraft = DateDraft(TempData["ReservationEndDraft"]);
    var showReservationForm = TempData.ContainsKey("ReservationStartDraft") || TempData.ContainsKey("ReservationEndDraft");
    var todayValue = DateTime.Today.ToString("yyyy-MM-dd");
}

<a asp-controller="Equipment"
   asp-action="Index"
   class="back-link">&lt; Back to Equipment List</a>

<div class="row g-4 mt-1">

    @* Photo *@
    <div class="col-md-5 col-lg-4">
        <img src="@photoSource"
             alt="@photoAlt"
             class="detail-photo @(hasPhoto ? "" : "detail-photo-placeholder")" />
    </div>

    @* Item information *@
    <div class="col-md-7 col-lg-8">

        <h2 class="h4 fw-bold mb-3">@Model.Name</h2>

        <dl class="detail-list">
            <dt>Category</dt>
            <dd>@Model.Category.CategoryName</dd>

            <dt>Serial Number</dt>
            <dd>@Model.SerialNumber</dd>

            <dt>Location</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Location) ? "Not specified" : Model.Location)</dd>

            <dt>Condition</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Condition) ? "Not specified" : Model.Condition)</dd>

            <dt>Status</dt>
            <dd>
                @if (displayStatus == "Available")
                {
                    <span class="badge bg-success">Available</span>
                }
                else if (displayStatus == "Checked Out")
                {
                    <span class="badge bg-warning text-dark">Checked Out</span>
                }
                else if (displayStatus == "Reserved")
                {
                    <span class="badge bg-info text-dark">Reserved</span>

                    @if (reservedForMe)
                    {
                        <span class="small ms-1">Reserved for you today</span>
                    }
                }
                else
                {
                    <span class="badge bg-secondary">@displayStatus</span>
                }
            </dd>

            @* Administrators see why an item is Under Repair *@
            @if (isAdmin && Model.Status == "Under Repair" && !string.IsNullOrWhiteSpace(Model.RepairNote))
            {
                <dt>Repair Note</dt>
                <dd>@Model.RepairNote</dd>
            }

            <dt>Description</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description available." : Model.Description)</dd>
        </dl>
    </div>
</div>

@* Administrator actions: Edit (US-8), Change Status (US-10), and Retire (US-9) *@
@if (isAdmin)
{
    <div class="detail-actions mt-4">

        @if (activeCheckout != null)
        {
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <p class="mb-0">
                    Checked out to
                    <strong>@activeCheckout.User.FirstName @activeCheckout.User.LastName</strong>,
                    due @activeCheckout.DueDate.ToString("MM/dd/yyyy")@(activeCheckout.DueDate.Date < DateTime.Today ? " (Overdue)" : "").
                </p>

                @* Records the return on the employee's behalf (US-21) *@
                <form asp-controller="Equipment"
                      asp-action="RecordReturn"
                      asp-route-id="@Model.EquipmentId"
                      method="post"
                      class="m-0"
                      data-submit-once>
                    <button type="submit"
                            class="btn btn-sm btn-outline-light"
                            title="Use when the employee has handed the item back">
                        Record Return
                    </button>
                </form>
            </div>
        }

        @* Edit and Retire on one row; Change Status below *@
        <div class="d-flex flex-wrap align-items-center gap-3">

            <a asp-controller="Equipment"
               asp-action="Edit"
               asp-route-id="@Model.EquipmentId"
               class="btn btn-outline-light fw-bold px-4">
                Edit
            </a>


            <a asp-controller="Equipment"
               asp-action="Retire"
               asp-route-id="@Model.EquipmentId"
               class="btn btn-outline-danger fw-bold px-4 @(isRetired ? "disabled" : "")"
               title="Remove from service; history is kept"
               aria-disabled="@(isRetired ? "true" : "false")">
                Retire
            </a>
        </div>

        @if (!isRetired)
        {
            @* A checked-out item can only be marked Lost from here *@
            <form asp-controller="Equipment"
                  asp-action="ChangeStatus"
                  asp-route-id="@Model.EquipmentId"
                  method="post"
                  class="d-flex flex-wrap align-items-end gap-2 mt-3"
                  data-submit-once>

                <div>
                    <label for="status-select" class="form-label small mb-1">Change Status</label>
                    <select id="status-select"
                            name="status"
                            class="form-select status-select">
                        @foreach (var status in EquipmentOptions.AdminStatuses)
                        {
                            var allowed = activeCheckout == null || status == "Lost";

                            <option value="@status"
                                    selected="@(status == selectedStatus)"
                                    disabled="@(!allowed)">@status</option>
                        }
                    </select>
                </div>

                <button type="submit"
                        class="btn btn-outline-light px-3">
                    Update
                </button>

                @* Shown only when Under Repair is chosen, and required then *@
                <div class="w-100 @(selectedStatus == "Under Repair" ? "" : "d-none")"
                     data-repair-note-for="status-select">
                    <label for="repair-note" class="form-label small mb-1">
                        Repair Note <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <textarea id="repair-note"
                              name="repairNote"
                              class="form-control repair-note-input"
                              rows="2"
                              maxlength="255"
                              placeholder="Screen cracked; sent to IT for replacement"
                              aria-describedby="repair-note-count">@repairNoteValue</textarea>
                    <div id="repair-note-count" class="form-text" data-char-count></div>
                </div>
            </form>
        }

        @if (activeCheckout != null && !isRetired)
        {
            <p class="small mt-2 mb-0">
                While the item is checked out, it can only be marked Lost. That closes the employee's checkout.
            </p>
        }
    </div>
}

@* Item History (FR-32, US-28). Administrators only. *@
@if (isAdmin && checkoutHistory != null && changeHistory != null)
{
    <section class="mt-5" aria-labelledby="item-history-heading">
        <h2 id="item-history-heading" class="h5 fw-bold mb-3">Item History</h2>

        @* Every checkout: user, checkout date, due date, and return date, newest first *@
        <h3 id="checkout-history" class="h6 fw-bold mb-2">Checkouts</h3>

        @if (checkoutHistory.TotalCount == 0)
        {
            <p>This item has not been checked out yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table app-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Employee</th>
                            <th scope="col">Checked Out</th>
                            <th scope="col">Due Date</th>
                            <th scope="col">Returned</th>
                            <th scope="col">Result</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in checkoutHistory.Items)
                        {
                            <tr class="@(row.IsOverdue ? "row-overdue" : "")">
                                <td>@row.EmployeeName</td>
                                <td>@row.CheckoutDate.ToString("MM/dd/yyyy")</td>
                                <td>@row.DueDate.ToString("MM/dd/yyyy")</td>
                                <td>
                                    @(row.ReturnDate.HasValue && !row.MarkedLost
                                        ? row.ReturnDate.Value.ToString("MM/dd/yyyy")
                                        : "-")

                                    @if (row.RecordedByName != null)
                                    {
                                        <div class="small">Recorded by @row.RecordedByName</div>
                                    }
                                </td>
                                <td class="@(row.IsOverdue ? "fw-bold" : "")">@row.Result</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pager"
                     model="@(new EquipmentInventoryApp.ViewModels.PagerViewModel { Page = checkoutHistory.Page, TotalPages = checkoutHistory.TotalPages, PageParameter = "checkoutPage", Anchor = "checkout-history", Label = "Checkouts" })" />
        }

        @* Status changes, edits, retirement, and other recorded changes *@
        <h3 id="change-history" class="h6 fw-bold mt-4 mb-2">Changes</h3>

        @if (changeHistory.TotalCount == 0)
        {
            <p>No changes have been recorded for this item yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table app-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Event</th>
                            <th scope="col">Details</th>
                            <th scope="col">By</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in changeHistory.Items)
                        {
                            <tr>
                                <td class="text-nowrap">@row.Date.ToString("MM/dd/yyyy h:mm tt")</td>
                                <td class="text-nowrap">@row.Event</td>
                                <td>@row.Details</td>
                                <td>@row.By</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pager"
                     model="@(new EquipmentInventoryApp.ViewModels.PagerViewModel { Page = changeHistory.Page, TotalPages = changeHistory.TotalPages, PageParameter = "changePage", Anchor = "change-history", Label = "Changes" })" />
        }
    </section>
}

@* Employee actions. Check Out is enabled only when the item is Available
   and the employee is under the checkout limit. *@
@if (checkout != null)
{
    <div class="detail-actions mt-4">
        @if (checkout.CanCheckOut)
        {
            <form asp-controller="Checkouts"
                  asp-action="CheckOut"
                  asp-route-id="@Model.EquipmentId"
                  method="post"
                  class="d-inline"
                  data-submit-once>
                <button type="submit"
                        class="btn btn-outline-light fw-bold px-4">
                    Check Out
                </button>
            </form>

            <p class="small mt-2 mb-0">
                If checked out today, this item is due back on
                <strong>@checkout.DueDateIfCheckedOutToday.ToString("MM/dd/yyyy")</strong>.
                You have @checkout.ActiveCheckouts of @checkout.MaxActiveCheckouts items checked out.
            </p>
        }
        else
        {
            <button type="button"
                    class="btn btn-outline-light fw-bold px-4"
                    disabled
                    aria-describedby="checkout-reason">
                Check Out
            </button>

            <p id="checkout-reason" class="small mt-2 mb-0">
                @checkout.Reason
            </p>
        }

        @* Request Reservation and Report Damage (US-23, US-29). Not offered for retired items. *@
        @if (Model.Status != "Retired")
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button"
                        class="btn btn-outline-light px-4"
                        data-bs-toggle="collapse"
                        data-bs-target="#request-reservation"
                        aria-expanded="@(showReservationForm ? "true" : "false")"
                        aria-controls="request-reservation">
                    Request Reservation
                </button>

                <a asp-controller="DamageReports"
                   asp-action="Create"
                   asp-route-equipmentId="@Model.EquipmentId"
                   class="btn btn-outline-light px-4">
                    Report Damage
                </a>
            </div>

            @* Start and end date picker (fields Res-1, Res-2). The server checks the dates again. *@
            <section id="request-reservation"
                     class="collapse reservation-panel mt-3 @(showReservationForm ? "show" : "")"
                     aria-labelledby="request-reservation-heading">

                <h3 id="request-reservation-heading" class="h6 fw-bold mb-1">Request Reservation</h3>
                <p class="small mb-3">
                    Choose the days you need this item. Your request is saved as Pending
                    until an administrator approves or denies it.
                </p>

                <form asp-controller="Reservations"
                      asp-action="Create"
                      method="post"
                      class="d-flex flex-wrap align-items-end gap-3"
                      data-submit-once
                      data-date-range
                      novalidate>

                    <input type="hidden" name="EquipmentId" value="@Model.EquipmentId" />

                    <div>
                        <label for="reservation-start" class="form-label small mb-1">
                            Start Date <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <input type="date"
                               id="reservation-start"
                               name="StartDate"
                               class="form-control"
                               min="@todayValue"
                               value="@reservationStartDraft"
                               required
                               data-range-start />
                    </div>

                    <div>
                        <label for="reservation-end" class="form-label small mb-1">
                            End Date <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <input type="date"
                               id="reservation-end"
                               name="EndDate"
                               class="form-control"
                               min="@(reservationStartDraft ?? todayValue)"
                               value="@reservationEndDraft"
                               required
                               data-range-end />
                    </div>

                    <button type="submit" class="btn btn-outline-light fw-bold px-4">
                        Submit Request
                    </button>

                    <p class="field-error small w-100 mb-0 d-none" data-range-error role="alert">
                        Please enter a valid date range
                    </p>
                </form>

                @* Dates that are already approved for someone, so the employee can pick others *@
                @if (upcomingReservations.Any())
                {
                    <div class="small mt-3">
                        <span class="fw-bold">Already reserved:</span>
                        @string.Join(", ", upcomingReservations.Select(r =>
                            r.StartDate.Date == r.EndDate.Date
                                ? r.StartDate.ToString("MM/dd/yyyy")
                                : $"{r.StartDate:MM/dd/yyyy} to {r.EndDate:MM/dd/yyyy}"))
                    </div>
                }
            </section>
        }
    </div>
}
