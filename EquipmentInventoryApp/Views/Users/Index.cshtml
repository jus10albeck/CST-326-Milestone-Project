@model List<EquipmentInventoryApp.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
    <h2 class="h4 fw-bold mb-0">User Management</h2>

    <a asp-controller="Users"
       asp-action="Create"
       class="btn btn-outline-light fw-bold">
        + Create Account
    </a>
</div>

<p class="mb-4">Create accounts, reset passwords, and activate or deactivate accounts.</p>

<div class="table-responsive">
    <table class="table app-table mb-0">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Status</th>
                <th scope="col" class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="align-middle">
                        @user.FullName
                        @if (user.IsCurrentUser)
                        {
                            <span class="small text-secondary-light">(you)</span>
                        }
                    </td>

                    <td class="align-middle">@user.Email</td>

                    <td class="align-middle">@user.Role</td>

                    <td class="align-middle">
                        @if (user.Status == "Active")
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (user.Status == "Deactivated")
                        {
                            <span class="badge bg-secondary">Deactivated</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@user.Status</span>
                        }

                        @if (user.MustChangePassword)
                        {
                            <div class="small mt-1">Temporary password</div>
                        }
                    </td>

                    <td class="text-end align-middle">
                        @if (user.IsCurrentUser)
                        {
                            <a asp-controller="Account"
                               asp-action="ChangePassword"
                               class="btn btn-sm btn-outline-light">Change Password</a>
                        }
                        else
                        {
                            <a asp-controller="Users"
                               asp-action="ResetPassword"
                               asp-route-id="@user.UserId"
                               class="btn btn-sm btn-outline-light">Reset Password</a>

                            <form asp-controller="Users"
                                  asp-action="SetStatus"
                                  asp-route-id="@user.UserId"
                                  method="post"
                                  class="d-inline"
                                  data-submit-once>

                                @if (user.Status == "Active")
                                {
                                    <input type="hidden" name="status" value="Deactivated" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger ms-1"
                                            aria-label="Deactivate @user.FullName">
                                        Deactivate
                                    </button>
                                }
                                else
                                {
                                    <input type="hidden" name="status" value="Active" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-success ms-1"
                                            aria-label="Activate @user.FullName">
                                        Activate
                                    </button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
