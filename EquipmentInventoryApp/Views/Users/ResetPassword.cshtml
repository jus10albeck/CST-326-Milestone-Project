@model EquipmentInventoryApp.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<a asp-controller="Users"
   asp-action="Index"
   class="back-link">&lt; Back to User Management</a>

<div class="form-panel form-panel-narrow mt-3">

    <h2 class="h4 fw-bold mb-1">Reset Password</h2>

    <p class="small mb-4">
        Set a temporary password for <strong>@Model.FullName</strong>.
        They will be logged out and must choose a new password the next time they log in.
    </p>

    <form asp-controller="Users"
          asp-action="ResetPassword"
          method="post"
          autocomplete="off"
          data-submit-once>

        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="TemporaryPassword" class="form-label">
                Temporary Password <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <input asp-for="TemporaryPassword"
                   class="form-control"
                   autocomplete="new-password"
                   aria-describedby="password-help" />
            <div id="password-help" class="form-text">
                At least 8 characters, including a letter and a number.
            </div>
            <span asp-validation-for="TemporaryPassword" class="field-error small"></span>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-outline-light fw-bold px-4">
                Reset Password
            </button>

            <a asp-controller="Users"
               asp-action="Index"
               class="btn btn-outline-secondary px-4">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
