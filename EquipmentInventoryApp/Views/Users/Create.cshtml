@model EquipmentInventoryApp.ViewModels.CreateAccountViewModel

@{
    ViewData["Title"] = "Create Account";
}

<a asp-controller="Users"
   asp-action="Index"
   class="back-link">&lt; Back to User Management</a>

<div class="form-panel mt-3">

    <h2 class="h4 fw-bold mb-1">Create Account</h2>

    <p class="small mb-4">
        Fields marked <span class="required-mark">*</span> are required.
        The new user must change the temporary password the first time they log in.
    </p>

    <form asp-controller="Users"
          asp-action="Create"
          method="post"
          autocomplete="off"
          data-submit-once>

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger py-2 small"
             role="alert"></div>

        <div class="row g-3">

            @* Acct-1 *@
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label">
                    First Name <span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="FirstName" class="form-control" maxlength="50" placeholder="Justin" />
                <span asp-validation-for="FirstName" class="field-error small"></span>
            </div>

            @* Acct-2 *@
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label">
                    Last Name <span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="LastName" class="form-control" maxlength="50" placeholder="Albecker" />
                <span asp-validation-for="LastName" class="field-error small"></span>
            </div>

            @* Acct-3 *@
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">
                    Email <span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="Email" class="form-control" placeholder="jalbecker@company.com" />
                <span asp-validation-for="Email" class="field-error small"></span>
            </div>

            @* Acct-4 *@
            <div class="col-md-6">
                <label asp-for="Role" class="form-label">
                    Role <span class="required-mark" aria-hidden="true">*</span>
                </label>
                <select asp-for="Role"
                        asp-items="new SelectList(EquipmentInventoryApp.Models.AccountRules.Roles, Model.Role)"
                        class="form-select">
                </select>
                <span asp-validation-for="Role" class="field-error small"></span>
            </div>

            @* Acct-5 *@
            <div class="col-md-6">
                <label asp-for="TemporaryPassword" class="form-label">
                    Temporary Password <span class="required-mark" aria-hidden="true">*</span>
                </label>
                <input asp-for="TemporaryPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-describedby="password-help" />
                <div id="password-help" class="form-text">
                    At least 8 characters, including a letter and a number.
                </div>
                <span asp-validation-for="TemporaryPassword" class="field-error small"></span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-outline-light fw-bold px-4">
                Create Account
            </button>

            <a asp-controller="Users"
               asp-action="Index"
               class="btn btn-outline-secondary px-4">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
