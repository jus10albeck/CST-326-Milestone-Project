<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Equipment Inventory</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/EquipmentInventoryApp.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/app.css"
          asp-append-version="true" />
</head>

<body class="app-page">
    <header class="app-header">

        @* Top row: application name, user name, and log out *@
        <div class="app-topbar">
            <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between gap-2">

                <a class="app-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Equipment Inventory
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="app-user d-flex align-items-center">
                        <span>@User.Identity.Name</span>

                        <span class="app-divider" aria-hidden="true">|</span>

                        <a asp-controller="Account"
                           asp-action="ChangePassword">Change Password</a>

                        <span class="app-divider" aria-hidden="true">|</span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="m-0">
                            <button type="submit"
                                    class="btn btn-link app-logout">
                                Log out
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login">Log in</a>
                }
            </div>
        </div>

        @* Second row: page links for the user's role.
           More links will be added as their pages are built. *@
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="app-nav" aria-label="Main navigation">
                <div class="container-fluid">
                    <ul class="app-nav-list">

                        @if (User.IsInRole("Administrator"))
                        {
                            <li>
                                <a asp-controller="Admin"
                                   asp-action="Index">Dashboard</a>
                            </li>
                        }

                        <li>
                            <a asp-controller="Equipment"
                               asp-action="Index">Equipment</a>
                        </li>

                        @if (User.IsInRole("Employee"))
                        {
                            <li>
                                <a asp-controller="Checkouts"
                                   asp-action="MyEquipment">My Equipment</a>
                            </li>
                        }

                        @if (User.IsInRole("Administrator"))
                        {
                            <li>
                                <a asp-controller="Categories"
                                   asp-action="Index">Categories</a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        }
    </header>

    <div class="container-fluid app-content">
        <main role="main" class="pb-4">

            @* Shows a one-time success message, such as "Equipment added." *@
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="status">
                    @successMessage
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close"></button>
                </div>
            }

            @* Shows a one-time error message *@
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">
                    @errorMessage
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
