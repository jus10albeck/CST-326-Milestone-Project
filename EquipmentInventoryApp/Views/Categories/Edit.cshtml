@model EquipmentInventoryApp.ViewModels.CategoryEditViewModel

@{
    ViewData["Title"] = "Rename Category";
}

<a asp-controller="Categories"
   asp-action="Index"
   class="back-link">&lt; Back to Categories</a>

<div class="form-panel form-panel-narrow mt-3">

    <h2 class="h4 fw-bold mb-4">Rename Category</h2>

    <form asp-controller="Categories"
          asp-action="Edit"
          method="post">

        <input type="hidden" asp-for="CategoryId" />

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label">
                Category Name <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <input asp-for="CategoryName"
                   class="form-control"
                   autocomplete="off" />
            <span asp-validation-for="CategoryName"
                  class="field-error small"></span>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit"
                    class="btn btn-outline-light fw-bold px-4">
                Save
            </button>

            <a asp-controller="Categories"
               asp-action="Index"
               class="btn btn-outline-secondary px-4">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
