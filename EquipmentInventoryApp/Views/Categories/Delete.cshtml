@model EquipmentInventoryApp.ViewModels.CategoryDeleteViewModel

@{
    ViewData["Title"] = "Delete Category";

    var showMissing = ViewBag.ShowMissing as bool? == true;
    var hasItems = Model.Items.Any();
    var canDelete = !hasItems || Model.OtherCategories.Any();
}

<a asp-controller="Categories"
   asp-action="Index"
   class="back-link">&lt; Back to Categories</a>

<div class="form-panel mt-3">

    <h2 class="h4 fw-bold mb-3">Delete Category: @Model.CategoryName</h2>

    <form asp-controller="Categories"
          asp-action="Delete"
          method="post"
          data-submit-once>

        <input type="hidden" asp-for="CategoryId" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger py-2 small"
             role="alert"></div>

        @if (!hasItems)
        {
            <p>No equipment uses this category. Select Confirm to delete it.</p>
        }
        else if (!canDelete)
        {
            <div class="alert alert-warning small" role="alert">
                This is the only category, so its items have nowhere to move.
                Add another category before deleting this one.
            </div>
        }
        else
        {
            <p>
                @Model.Items.Count item(s) use this category. Choose a new category for each item,
                then select Confirm. The items will be moved and this category will be deleted.
            </p>

            @* Sets every row at once. Each row can still be changed afterwards. *@
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <label for="move-all" class="mb-0">Move all items to:</label>
                <select id="move-all"
                        class="form-select move-all-select"
                        asp-items="Model.OtherCategories">
                    <option value="">Choose a category</option>
                </select>
            </div>

            <div class="table-responsive">
                <table class="table app-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col">Serial Number</th>
                            <th scope="col">Status</th>
                            <th scope="col">New Category</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (var i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td class="align-middle">
                                    @* Opens in a new tab so the choices on this page are kept *@
                                    <a asp-controller="Equipment"
                                       asp-action="Details"
                                       asp-route-id="@Model.Items[i].EquipmentId"
                                       target="_blank"
                                       rel="noopener">@Model.Items[i].Name</a>

                                    <input type="hidden" asp-for="Items[i].EquipmentId" />
                                </td>

                                <td class="align-middle">@Model.Items[i].SerialNumber</td>

                                <td class="align-middle">@Model.Items[i].Status</td>

                                <td>
                                    <select asp-for="Items[i].NewCategoryId"
                                            asp-items="Model.OtherCategories"
                                            class="form-select form-select-sm reassign-select @(showMissing && Model.Items[i].NewCategoryId == null ? "input-validation-error" : "")"
                                            aria-label="New category for @Model.Items[i].Name">
                                        <option value="">Choose a category</option>
                                    </select>

                                    @if (showMissing && Model.Items[i].NewCategoryId == null)
                                    {
                                        <span class="field-error small">Choose a category</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit"
                    class="btn btn-danger fw-bold px-4"
                    disabled="@(!canDelete)">
                Confirm
            </button>

            <a asp-controller="Categories"
               asp-action="Index"
               class="btn btn-outline-secondary px-4">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // "Move all items to" copies its choice into every row
        (function () {
            var moveAll = document.getElementById("move-all");

            if (!moveAll) {
                return;
            }

            moveAll.addEventListener("change", function () {
                if (moveAll.value === "") {
                    return;
                }

                document.querySelectorAll(".reassign-select").forEach(function (select) {
                    select.value = moveAll.value;
                    select.classList.remove("input-validation-error");

                    var message = select.parentElement.querySelector(".field-error");

                    if (message) {
                        message.remove();
                    }
                });
            });
        })();
    </script>
}
