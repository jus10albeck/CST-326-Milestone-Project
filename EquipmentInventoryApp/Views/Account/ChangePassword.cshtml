@model EquipmentInventoryApp.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";

    // True when the user signed in with a temporary password
    var mustChange = User.FindFirst(
        EquipmentInventoryApp.Services.MustChangePasswordFilter.ClaimType)?.Value == "true";
}

<div class="form-panel form-panel-narrow mx-auto mt-3">

    <h2 class="h4 fw-bold mb-1">Change Password</h2>

    @if (mustChange)
    {
        <div class="alert alert-warning small mt-3" role="alert">
            You are using a temporary password. Choose a new password before continuing.
        </div>
    }
    else
    {
        <p class="small mb-4">Enter your current password and choose a new one.</p>
    }

    <form asp-controller="Account"
          asp-action="ChangePassword"
          method="post"
          data-submit-once>

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger py-2 small"
             role="alert"></div>

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label">
                @(mustChange ? "Temporary Password" : "Current Password")
                <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-error small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">
                New Password <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <input asp-for="NewPassword"
                   class="form-control"
                   autocomplete="new-password"
                   aria-describedby="new-password-help" />
            <div id="new-password-help" class="form-text">
                At least 8 characters, including a letter and a number.
            </div>
            <span asp-validation-for="NewPassword" class="field-error small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">
                Confirm New Password <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error small"></span>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-outline-light fw-bold px-4">
                Change Password
            </button>

            @* Only shown when the user is allowed to leave this page *@
            @if (!mustChange)
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    Cancel
                </a>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
